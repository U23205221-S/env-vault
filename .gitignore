# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
env-vault
env-vault-*

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# env-vault runtime artifacts
# This repo is the tool itself. Each team's vault data (manifest.json,
# *.enc, keys) lives in THEIR project repo, never here. Ignore everything
# produced by 'env-vault init/push/pull' so a stray 'git add .env-vault/'
# in this repo is a no-op.
.env-vault/*

# IDEA
.vscode/
.idea/
# Local Pi runtime state
.atl/
.pi/
openspec/
